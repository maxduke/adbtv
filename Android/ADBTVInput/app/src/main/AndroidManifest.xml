<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:label="ADB TV Helper"
        android:supportsRtl="true">
        <service
            android:name=".ADBTVInputMethodService"
            android:exported="true"
            android:label="ADB TV Input"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/input_method" />
        </service>

        <receiver
            android:name=".TextCommitReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.maxduke.adbtv.helper.v3.COMMIT_TEXT" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".InstalledAppProvider"
            android:authorities="com.maxduke.adbtv.helper.v3.apps"
            android:exported="true"
            android:grantUriPermissions="false"
            android:readPermission="android.permission.DUMP"
            android:writePermission="android.permission.DUMP" />
    </application>
</manifest>
